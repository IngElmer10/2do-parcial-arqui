    <packagedElement xmi:type="uml:Activity" xmi:id="act_template" name="Crear sesión de asistencia (Template Method)">
      <node xmi:type="uml:InitialNode" xmi:id="node_template_init" name="Inicio">
        <outgoing>flow_init_resolve</outgoing>
      </node>
      <node xmi:type="uml:CallOperationAction" xmi:id="node_resolve_template" name="AttendanceService.resolveSessionTemplate(session_type)" operation="op_service_resolve">
        <ownedComment xmi:id="cmt_resolve_template" body="Selecciona NormalAttendanceSessionTemplate o ExamAttendanceSessionTemplate según session_type."/>
        <target xmi:type="uml:InputPin" xmi:id="pin_resolve_service" name="attendanceService" type="cls_attendance_service"/>
        <argument xmi:type="uml:InputPin" xmi:id="pin_resolve_type" name="session_type" type="type_string"/>
        <result xmi:type="uml:OutputPin" xmi:id="pin_resolve_template" name="template" type="cls_base_template"/>
        <incoming>flow_init_resolve</incoming>
        <outgoing>flow_resolve_create</outgoing>
      </node>
      <node xmi:type="uml:CallOperationAction" xmi:id="node_normalize" name="BaseTemplate.normalizeData(rawData)" operation="op_template_normalize">
        <ownedComment xmi:id="cmt_normalize" body="Completa session_type y session_date con valores por defecto."/>
        <target xmi:type="uml:InputPin" xmi:id="pin_normalize_target" name="template" type="cls_base_template"/>
        <argument xmi:type="uml:InputPin" xmi:id="pin_normalize_raw" name="rawData" type="cls_normalized_session"/>
        <result xmi:type="uml:OutputPin" xmi:id="pin_normalize_data" name="data" type="cls_normalized_session"/>
        <incoming>flow_resolve_create</incoming>
        <outgoing>flow_normalize_identifiers</outgoing>
      </node>
      <node xmi:type="uml:CallOperationAction" xmi:id="node_identifiers" name="ensureRequiredIdentifiers(data)" operation="op_template_identifiers">
        <target xmi:type="uml:InputPin" xmi:id="pin_identifiers_template" name="template" type="cls_base_template"/>
        <argument xmi:type="uml:InputPin" xmi:id="pin_identifiers_data" name="data" type="cls_normalized_session"/>
        <incoming>flow_normalize_identifiers</incoming>
        <outgoing>flow_identifiers_date</outgoing>
      </node>
      <node xmi:type="uml:CallOperationAction" xmi:id="node_validate_date" name="validateDateRules(data)" operation="op_template_validate_date">
        <target xmi:type="uml:InputPin" xmi:id="pin_validate_date_template" name="template" type="cls_base_template"/>
        <argument xmi:type="uml:InputPin" xmi:id="pin_validate_date_data" name="data" type="cls_normalized_session"/>
        <incoming>flow_identifiers_date</incoming>
        <outgoing>flow_date_professor</outgoing>
      </node>
      <node xmi:type="uml:CallOperationAction" xmi:id="node_validate_professor" name="validateProfessor(professor_id)" operation="op_template_validate_professor">
        <target xmi:type="uml:InputPin" xmi:id="pin_validate_professor_template" name="template" type="cls_base_template"/>
        <argument xmi:type="uml:InputPin" xmi:id="pin_validate_professor_id" name="professor_id" type="type_integer"/>
        <incoming>flow_date_professor</incoming>
        <outgoing>flow_professor_group</outgoing>
      </node>
      <node xmi:type="uml:CallOperationAction" xmi:id="node_fetch_group" name="fetchAndValidateGroup(group_id)" operation="op_template_fetch_group">
        <target xmi:type="uml:InputPin" xmi:id="pin_fetch_group_template" name="template" type="cls_base_template"/>
        <argument xmi:type="uml:InputPin" xmi:id="pin_fetch_group_id" name="group_id" type="type_integer"/>
        <result xmi:type="uml:OutputPin" xmi:id="pin_fetch_group_result" name="group" type="cls_group_summary"/>
        <incoming>flow_professor_group</incoming>
