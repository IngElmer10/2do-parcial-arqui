        <packagedElement xmi:type="uml:Component" xmi:id="cmp_enrollment_repository" name="EnrollmentRepository"/>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_teacher_assignment_repository" name="TeacherAssignmentRepository"/>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_catalog_user_client" name="UserServiceClient (catalog)">
          <ownedComment xmi:id="cmt_catalog_user_client" body="Cliente HTTP utilizado para validar profesores y estudiantes con user-service."/>
        </packagedElement>
