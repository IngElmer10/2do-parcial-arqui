<?xml version="1.0" encoding="UTF-8"?>
<XMI xmi.version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://www.omg.org/spec/UML/20090901">
  <uml:Model xmi:id="model_arch" name="Microservice Control de Asistencia - Arquitectura Detallada">
    <ownedComment xmi:id="cmt_arch_overview" body="Vista de componentes que describe los módulos clave del frontend, cada microservicio Node.js y sus dependencias de comunicación e integración con los esquemas MySQL dedicados."/>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_frontend" name="Frontend (React)">
      <ownedComment xmi:id="cmt_frontend" body="Aplicación SPA servida por Vite. Consume APIs REST y encapsula la autenticación, dashboards y exportación de reportes."/>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_app_shell" name="AppShell (App.jsx)">
        <ownedComment xmi:id="cmt_app_shell" body="Ensamblado principal que configura rutas y decide qué dashboard renderizar en función del rol autenticado."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_auth_context" name="AuthContext">
        <ownedComment xmi:id="cmt_auth_context" body="Contexto React que gestiona el estado de autenticación, token y usuario activo."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_api_service" name="ApiService (api.js)">
        <ownedComment xmi:id="cmt_api_service" body="Abstracción sobre fetch que centraliza cabeceras, manejo de errores y mapeo de endpoints REST."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_prof_dashboard" name="ProfessorDashboard">
        <ownedComment xmi:id="cmt_prof_dashboard" body="Panel docente que permite seleccionar grupos, iniciar sesiones y consultar histórico."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_student_dashboard" name="StudentDashboard">
        <ownedComment xmi:id="cmt_student_dashboard" body="Panel estudiantil con resumen de asistencias, materias inscritas y acceso al historial."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_attendance_session_component" name="AttendanceSession">
        <ownedComment xmi:id="cmt_attendance_session_component" body="Componente docente para abrir/cerrar sesiones, registrar asistencias y actualizar estados."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_session_history_component" name="SessionHistory">
        <ownedComment xmi:id="cmt_session_history_component" body="Listado de sesiones que permite explorar detalles y lanzar exportaciones en múltiples formatos."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_attendance_history_component" name="AttendanceHistory">
        <ownedComment xmi:id="cmt_attendance_history_component" body="Visualización de asistencias históricas del estudiante por materia o grupo."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_modal_component" name="Modal">
        <ownedComment xmi:id="cmt_modal_component" body="Componente reutilizable para diálogos y confirmaciones."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_loading_component" name="Loading">
        <ownedComment xmi:id="cmt_loading_component" body="Indicador visual reutilizable para estados de carga."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_export_context" name="AttendanceExportContext">
        <ownedComment xmi:id="cmt_export_context" body="Contexto del patrón Strategy. Selecciona la estrategia concreta y ejecuta la exportación."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Interface" xmi:id="intf_export_strategy" name="AttendanceExportStrategy">
        <ownedComment xmi:id="cmt_export_strategy" body="Contrato común para serializar registros de asistencia en diferentes formatos (PDF, CSV, Excel)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_pdf_strategy" name="PdfExportStrategy"/>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_csv_strategy" name="CsvExportStrategy"/>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_excel_strategy" name="ExcelExportStrategy"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_microservices" name="Microservicios Node.js">
      <ownedComment xmi:id="cmt_microservices" body="Servicios independientes con Express nativo (módulo http) que exponen APIs REST y encapsulan lógica de negocio."/>
