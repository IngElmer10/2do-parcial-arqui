          <ownedComment xmi:id="cmt_catalog_server" body="Punto de entrada que registra rutas de materias, grupos y asignaciones."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_subject_controller" name="SubjectController"/>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_subject_service" name="SubjectService">
