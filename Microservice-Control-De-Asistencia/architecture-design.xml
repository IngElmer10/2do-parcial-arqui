          <ownedComment xmi:id="cmt_attendance_server" body="Bootstrap del servicio; configura rutas HTTP y enlaza el controlador principal."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_attendance_controller" name="AttendanceController">
          <ownedComment xmi:id="cmt_attendance_controller" body="Orquesta endpoints de sesiones y delega la lógica de negocio al servicio."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_attendance_service_core" name="AttendanceService">
          <ownedComment xmi:id="cmt_attendance_service_core" body="Implementa reglas de creación/cierre de sesiones, validaciones y construcción de reportes."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_attendance_session_repo" name="AttendanceSessionRepository">
          <ownedComment xmi:id="cmt_attendance_session_repo" body="Acceso CRUD a la tabla attendance_sessions usando conexiones MySQL nativas."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_attendance_record_repo" name="AttendanceRecordRepository">
          <ownedComment xmi:id="cmt_attendance_record_repo" body="Gestiona registros individuales de asistencia y operaciones en lote."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_catalog_client" name="CatalogServiceClient">
          <ownedComment xmi:id="cmt_catalog_client" body="Cliente HTTP hacia catalog-service para validar materias, grupos y profesores."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_user_client" name="UserServiceClient">
          <ownedComment xmi:id="cmt_user_client" body="Cliente HTTP hacia user-service para obtener datos de profesores, estudiantes y matrículas."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_date_utils" name="dateUtils">
          <ownedComment xmi:id="cmt_date_utils" body="Normaliza formatos de fecha y calculos auxiliares para sesiones."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_http_utils_attendance" name="httpUtils">
          <ownedComment xmi:id="cmt_http_utils_attendance" body="Envoltura para respuestas HTTP coherentes (status, headers y mensajes de error)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_attendance_session_model" name="AttendanceSession (Model)"/>
        <packagedElement xmi:type="uml:Component" xmi:id="cmp_attendance_record_model" name="AttendanceRecord (Model)"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="pkg_catalog_service" name="Catalog Service (Puerto 3002)">
