<?xml version="1.0" encoding="UTF-8"?>
<XMI xmi.version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://www.omg.org/spec/UML/20090901">
  <uml:Model xmi:id="model_db" name="Microservice Control de Asistencia - Bases de Datos">
    <ownedComment xmi:id="cmt_db_overview" body="Modelo lógico separado en tres esquemas MySQL independientes, alineados con cada microservicio."/>
    <!-- Tipos comunes -->
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="type_INT" name="INT"/>
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="type_VARCHAR" name="VARCHAR"/>
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="type_TEXT" name="TEXT"/>
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="type_DATETIME" name="DATETIME"/>
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="type_BOOLEAN" name="BOOLEAN"/>
    <!-- users_db -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_users_db" name="users_db">
      <ownedComment xmi:id="cmt_users_db" body="Esquema del user-service. Gestiona credenciales y perfiles de usuario."/>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_users" name="users">
        <ownedAttribute xmi:id="attr_users_id" name="id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_users_username" name="username" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_users_password" name="password_hash" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_users_role" name="role" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_users_created" name="created_at" type="type_DATETIME"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_professors" name="professors">
        <ownedAttribute xmi:id="attr_professors_id" name="id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_professors_user" name="user_id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_professors_employee" name="employee_code" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_professors_department" name="department" type="type_VARCHAR"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_students" name="students">
        <ownedAttribute xmi:id="attr_students_id" name="id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_students_user" name="user_id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_students_code" name="student_code" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_students_career" name="career" type="type_VARCHAR"/>
      </packagedElement>
    </packagedElement>
    <!-- catalog_db -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_catalog_db" name="catalog_db">
      <ownedComment xmi:id="cmt_catalog_db" body="Esquema del catalog-service. Mantiene catálogos académicos."/>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_subjects" name="subjects">
        <ownedAttribute xmi:id="attr_subjects_id" name="id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_subjects_code" name="code" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_subjects_name" name="name" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_subjects_desc" name="description" type="type_TEXT"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_groups" name="groups">
        <ownedAttribute xmi:id="attr_groups_id" name="id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_groups_subject" name="subject_id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_groups_code" name="code" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_groups_term" name="term" type="type_VARCHAR"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_group_professors" name="group_professors">
        <ownedAttribute xmi:id="attr_gp_id" name="id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_gp_group" name="group_id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_gp_professor" name="professor_id" type="type_INT"/>
      </packagedElement>
    </packagedElement>
    <!-- attendance_db -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_attendance_db" name="attendance_db">
      <ownedComment xmi:id="cmt_attendance_db" body="Esquema del attendance-service. Controla sesiones y registros de asistencia."/>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_sessions" name="attendance_sessions">
        <ownedAttribute xmi:id="attr_sessions_id" name="id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_sessions_group" name="group_id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_sessions_professor" name="professor_id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_sessions_type" name="session_type" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_sessions_opened" name="opened_at" type="type_DATETIME"/>
        <ownedAttribute xmi:id="attr_sessions_closed" name="closed_at" type="type_DATETIME"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_records" name="attendance_records">
        <ownedAttribute xmi:id="attr_records_id" name="id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_records_session" name="session_id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_records_student" name="student_id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_records_status" name="status" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_records_marked" name="marked_at" type="type_DATETIME"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_records_audit" name="attendance_record_audit">
        <ownedAttribute xmi:id="attr_audit_id" name="id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_audit_record" name="record_id" type="type_INT"/>
        <ownedAttribute xmi:id="attr_audit_action" name="action" type="type_VARCHAR"/>
        <ownedAttribute xmi:id="attr_audit_timestamp" name="changed_at" type="type_DATETIME"/>
      </packagedElement>
    </packagedElement>
    <!-- Relaciones dentro de cada base -->
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_professors_user" memberEnd="attr_professors_user attr_users_id"/>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_students_user" memberEnd="attr_students_user attr_users_id"/>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_groups_subject" memberEnd="attr_groups_subject attr_subjects_id"/>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_gp_group" memberEnd="attr_gp_group attr_groups_id"/>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_sessions_group" memberEnd="attr_sessions_group attr_groups_id"/>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_sessions_professor" memberEnd="attr_sessions_professor attr_professors_id"/>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_records_session" memberEnd="attr_records_session attr_sessions_id"/>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_records_student" memberEnd="attr_records_student attr_students_id"/>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_audit_record" memberEnd="attr_audit_record attr_records_id"/>
  </uml:Model>
</XMI>
